{
  "name": "linkcode",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:seed": "dotenv -e .env.local -- node prisma/seed.js",
    "capture": "node scripts/capture-showcases.mjs",
    "upload-media": "node scripts/upload-media.mjs",
    "test:api": "node scripts/api-test.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/storage-js": "^2.109.0",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.0",
    "lucide-react": "^1.51.0",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^8.0.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13"
  }
}
