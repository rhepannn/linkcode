# Salin ke .env.local lalu isi. File .env.local TIDAK ikut git. Di Vercel isi lewat
# Project Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Database (Supabase) — Dashboard → Connect → ORMs → Prisma.
# Password dengan karakter khusus harus di-URL-encode.
# ---------------------------------------------------------------------------
# LOKAL (server berjalan terus): session pooler :5432. connection_limit dibuat kecil karena
# `next build` memakai banyak worker paralel dan session pooler dibatasi 15 klien.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connection_limit=2"
# VERCEL / SERVERLESS: pakai transaction pooler :6543 (banyak instance singkat) — ganti baris di atas dengan:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Hanya untuk Prisma CLI (migrasi): koneksi yang mendukung DDL.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Sesi admin — WAJIB, minimal 32 karakter. Buat dengan:  openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=

# Akun admin awal untuk `npm run db:seed` (dibuat hanya bila belum ada).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Nomor WhatsApp awal (bisa diubah dari Admin → Pengaturan).
SEED_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Supabase Storage (media portofolio). SERVICE ROLE KEY = RAHASIA, hanya untuk server:
# jangan pernah diberi awalan NEXT_PUBLIC_ dan jangan di-commit.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=showcases

# ---------------------------------------------------------------------------
# Publik (aman terlihat di browser)
# ---------------------------------------------------------------------------
# URL kanonis situs untuk SEO (canonical, sitemap, Open Graph). Isi domain produksi.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cadangan nomor WhatsApp bila belum ada di database.
NEXT_PUBLIC_WHATSAPP_NUMBER=628xxxxxxxxxx
