generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  percentage  Int // 0-100
  status      Status   @default(active)
  icon        String // emoji
  pics        PIC[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PIC {
  id           Int     @id @default(autoincrement())
  name         String
  role         String
  contribution Int // 0-100
  avatarColor  String // hex
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    Int
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Pengaturan situs (key-value) — mis. nomor WhatsApp. Bisa diedit dari admin.
model Setting {
  key   String @id
  value String
}

enum Status {
  active
  review
  hold
  done
}
