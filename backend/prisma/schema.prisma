generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime: koneksi pooled (Supabase pooler / PgBouncer, port 6543).
  url       = env("DATABASE_URL")
  // Migrasi: koneksi langsung (port 5432) — PgBouncer tidak cocok untuk DDL.
  directUrl = env("DIRECT_URL")
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  percentage  Int // 0-100
  status      Status   @default(active)
  icon        String // emoji
  pics        PIC[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PIC {
  id           Int     @id @default(autoincrement())
  name         String
  role         String
  contribution Int // 0-100
  avatarColor  String // hex
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    Int
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Pengaturan situs (key-value) — mis. nomor WhatsApp. Bisa diedit dari admin.
model Setting {
  key   String @id
  value String
}

// Karya portofolio: website/aplikasi buatan tim LinkCode.
model Showcase {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  url          String // URL website asli
  sector       Sector
  description  String
  year         Int?
  techStack    String[] @default([])
  thumbnailUrl String? // gambar kartu (viewport pertama)
  previewUrl   String? // screenshot halaman penuh (untuk hover-scroll)
  videoUrl     String? // rekaman scroll (cadangan jika tidak bisa di-iframe)
  featured     Boolean  @default(false)
  embeddable   Boolean  @default(false) // true jika situs mengizinkan di-iframe
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Sector {
  industri
  lingkungan
  pemerintahan
  platform
  bisnis
}

enum Status {
  active
  review
  hold
  done
}
