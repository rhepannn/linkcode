# --- Database (Supabase) ---
# Ambil dari Supabase Dashboard → Connect → ORMs → Prisma. Ganti [PROJECT-REF], [REGION], [PASSWORD].
# Password dengan karakter khusus harus di-URL-encode.
#
# Server Express yang berjalan terus → pakai SESSION pooler (port 5432) untuk runtime.
# (Transaction pooler :6543 ±5× lebih lambat per query; hanya cocok untuk serverless/Vercel,
#  dan di sana wajib menambah ?pgbouncer=true.)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connection_limit=10"

# Migrasi Prisma: session pooler yang sama (atau direct connection db.[PROJECT-REF].supabase.co:5432).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase Storage (unggah media portofolio) ---
# Dashboard → Project Settings → API. SERVICE ROLE KEY bersifat RAHASIA: hanya untuk backend,
# jangan pernah dimasukkan ke frontend atau di-commit.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Nama bucket publik (dibuat otomatis oleh `npm run upload-media` / `npm run capture`)
SUPABASE_BUCKET=showcases

JWT_SECRET=ganti-dengan-secret-yang-kuat
PORT=3000

# Origin frontend untuk konfigurasi CORS (opsional)
CORS_ORIGIN=http://localhost:5173

# Kredensial admin awal untuk seeding (opsional)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
