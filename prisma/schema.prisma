generator client {
  provider        = "prisma-client-js"
  // rhel-openssl-3.0.x = runtime Vercel (Amazon Linux); native = mesin lokal.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  // Satu query JOIN untuk relasi (bukan banyak query berurutan) → jauh lebih cepat ke DB jarak jauh.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  // Runtime: koneksi pooled (Supabase pooler / PgBouncer, port 6543).
  url       = env("DATABASE_URL")
  // Migrasi: koneksi langsung (port 5432) — PgBouncer tidak cocok untuk DDL.
  directUrl = env("DIRECT_URL")
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  // Otomatis dihitung dari fitur bila project punya fitur; selain itu diisi manual.
  percentage  Int // 0-100
  status      Status    @default(active)
  icon        String // emoji
  client      String?
  startDate   DateTime?
  targetDate  DateTime?
  stagingUrl  String?
  liveUrl     String?
  repoUrl     String?
  team        ProjectMember[]
  features    Feature[]
  updates     ProjectUpdate[]
  blockers    Blocker[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Anggota tim global: dibuat sekali, ditugaskan ke banyak project.
model Member {
  id          Int             @id @default(autoincrement())
  name        String
  role        String // jabatan, mis. "Frontend Dev"
  email       String?
  avatarColor String          @default("#5C6E21")
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  assignments ProjectMember[]
  features    Feature[]
}

model ProjectMember {
  id           Int         @id @default(autoincrement())
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    Int
  member       Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId     Int
  role         ProjectRole @default(member)
  contribution Int         @default(0) // 0-100

  @@unique([projectId, memberId])
}

model Feature {
  id          Int           @id @default(autoincrement())
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int
  title       String
  description String        @default("")
  status      FeatureStatus @default(next)
  assignee    Member?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  Int?
  dueDate     DateTime?
  sortOrder   Int           @default(0)
  completedAt DateTime?
  subtasks    Subtask[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Subtask {
  id        Int     @id @default(autoincrement())
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId Int
  title     String
  done      Boolean @default(false)
  sortOrder Int     @default(0)
}

// Catatan perkembangan berkala (linimasa).
model ProjectUpdate {
  id        Int      @id @default(autoincrement())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  note      String
  author    String
  createdAt DateTime @default(now())
}

model Blocker {
  id         Int           @id @default(autoincrement())
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  Int
  title      String
  detail     String        @default("")
  severity   Severity      @default(medium)
  status     BlockerStatus @default(open)
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?
}

// Percobaan login untuk pembatas laju (dibagi antar instance serverless).
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Pengaturan situs (key-value) — mis. nomor WhatsApp. Bisa diedit dari admin.
model Setting {
  key   String @id
  value String
}

// Karya portofolio: website/aplikasi buatan tim LinkCode.
model Showcase {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  url          String // URL website asli
  sector       Sector
  description  String
  year         Int?
  techStack    String[] @default([])
  thumbnailUrl String? // gambar kartu (viewport pertama)
  previewUrl   String? // screenshot halaman penuh (untuk hover-scroll)
  videoUrl     String? // rekaman scroll (cadangan jika tidak bisa di-iframe)
  featured     Boolean  @default(false)
  embeddable   Boolean  @default(false) // true jika situs mengizinkan di-iframe
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Sector {
  industri
  lingkungan
  pemerintahan
  platform
  bisnis
}

enum ProjectRole {
  lead
  member
}

enum FeatureStatus {
  next
  in_progress
  done
}

enum Severity {
  low
  medium
  high
}

enum BlockerStatus {
  open
  resolved
}

enum Status {
  active
  review
  hold
  done
}
